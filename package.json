{
  "name": "mrstockd",
  "private": true,
  "description": "AI tools, in stock. A marketplace where people and their AI agents discover, buy, and use AI tools, paid through PayPal.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @mrstockd/db generate",
    "db:migrate": "pnpm --filter @mrstockd/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  }
}
