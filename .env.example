# Copy to .env and fill in. Never commit .env.

# Database (Render Postgres in production; Postgres 15+ with pgvector locally; see README)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mrstockd
# Connections per app instance (web and gateway each open their own pool)
DATABASE_POOL_MAX=10

# Auth (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# PayPal (sandbox only for the hackathon): https://developer.paypal.com
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AI models (Vercel AI SDK providers)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Encrypts sellers' tool secrets. The web app encrypts, the gateway decrypts,
# so both must use the SAME value. Generate with: openssl rand -base64 32
UPSTREAM_SECRET_ENCRYPTION_KEY=
RATE_LIMIT_PER_MINUTE=60
UPSTREAM_TIMEOUT_MS=30000
# Lets sellers' tools run on localhost while developing. Refused in production.
GATEWAY_ALLOW_PRIVATE_UPSTREAMS=true
# Public address of the gateway, shown to buyers and sellers
GATEWAY_PUBLIC_URL=http://localhost:8787

# Comma-separated emails that can approve or reject listings at /admin/review
ADMIN_EMAILS=

# File storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mrstockd-assets

# Email (Resend) and observability
RESEND_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# MCP server (apps/mcp): the gateway it talks to, and the MrStockd keys your
# agent may use, comma separated. An MCP client's own settings override these.
MRSTOCKD_GATEWAY_URL=http://localhost:8787
MRSTOCKD_API_KEYS=
