{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @mrstockd/web start",
      "url": ["http://localhost:3000/", "http://localhost:3000/builders"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.85 }]
      }
    }
  }
}
